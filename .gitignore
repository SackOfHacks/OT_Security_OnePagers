# Office lock/owner files — created in-place whenever a .pptx source is opened
~$*.pptx
~$*.docx
~$*.xlsx
*.tmp

# PowerPoint/LibreOffice recovery + backup artefacts
*.~ppt*
.~lock.*#

# OS cruft
.DS_Store
._*
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Machine-local Claude Code settings — holds absolute paths from whichever
# workstation the repo is checked out on, so it must never be committed.
# Keep this here as well as in any personal global ignore: a fresh clone on
# another machine has only the repo's own rules to go on.
.claude/settings.local.json
